{
  "name": "receipt",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "facilitator": "pnpm --filter @receipt/facilitator start",
    "seller": "pnpm --filter @receipt/seller start",
    "buy": "pnpm --filter @receipt/buyer start",
    "verify": "pnpm --filter @receipt/verify start",
    "claim": "pnpm --filter @receipt/buyer claim",
    "scenes": "pnpm --filter @receipt/buyer scenes"
  },
  "devDependencies": {
    "@bazantic/cli": "0.10.0",
    "@types/node": "^22.20.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
