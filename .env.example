# ─── Hedera ────────────────────────────────────────────────────────────────
# Testnet account from https://portal.hedera.com (ECDSA, so it has an EVM alias)
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_OPERATOR_ID=                 # 0.0.xxxxx — pays for HCS submissions
HEDERA_OPERATOR_KEY=                # DER or hex private key for the operator
HCS_TOPIC_ID=                       # created in phase 3; leave blank to create one

# ─── Escrow (EVM side of Hedera testnet) ───────────────────────────────────
ESCROW_ADDRESS=                     # filled in after deploy
DEPLOYER_PRIVATE_KEY=               # 0x-prefixed ECDSA key with testnet HBAR
ADJUDICATOR_ADDRESS=                # EVM address that may call release/refund
ADJUDICATOR_PRIVATE_KEY=            # its key; the facilitator signs with this

# Units of msg.value per unit of the signed x402 `amount`.
# MEASURED, not assumed: Hedera's JSON-RPC relay takes a weibar `value` and
# divides by 1e10 at the boundary, so Solidity sees msg.value in TINYBARS.
# x402 `amount` is tinybars too, so they agree and the scale is 1.
# See the NatSpec in ReceiptEscrow.sol and DEPLOYMENTS.md.
VALUE_SCALE=1

# ─── x402 settlement via Blocky402 ─────────────────────────────────────────
# Values below are what GET /supported advertises on testnet. Re-check rather
# than trusting this file: curl https://api.testnet.blocky402.com/supported
BLOCKY402_FACILITATOR_URL=https://api.testnet.blocky402.com
BLOCKY402_NETWORK=hedera:testnet
BLOCKY402_FEE_PAYER=0.0.7162784     # facilitator's fee-payer account
SETTLEMENT_ASSET=0.0.0              # 0.0.0 is native HBAR; HTS tokens use their token id
FACILITATOR_HEDERA_ACCOUNT_ID=      # x402 payTo: where settlement lands before open()

# ─── Services ──────────────────────────────────────────────────────────────
SELLER_URL=http://localhost:8787
RECEIPT_FACILITATOR_URL=http://localhost:8080
FACILITATOR_PORT=8080
SELLER_PORT=8787
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
# PUBLIC_URL=                       # set when tunnelling, so /openapi.json advertises it

# ─── Buyer (the agent) ─────────────────────────────────────────────────────
BUYER_PRIVATE_KEY=                  # EVM key; signs Terms with EIP-712
BUYER_HEDERA_ACCOUNT_ID=            # 0.0.x; partially signs the x402 transfer
BUYER_EVM_ADDRESS=

# ─── Seller — receives release() ───────────────────────────────────────────
# A distinct account, so the demo shows money moving between real parties.
SELLER_EVM_ADDRESS=
SELLER_HEDERA_ACCOUNT_ID=
SELLER_PRIVATE_KEY=

# ─── Stranger ──────────────────────────────────────────────────────────────
# An unrelated wallet. Exists only to prove claimExpired needs no privileged
# party: demo scene 4 calls it from here, and it can only pay the payer.
STRANGER_EVM_ADDRESS=
STRANGER_HEDERA_ACCOUNT_ID=
STRANGER_PRIVATE_KEY=

# ─── The Graph — two products, both required ───────────────────────────────
# The seller composes them: the Token API says what an address holds, a
# subgraph says which markets those holdings trade in. Without both keys the
# seller returns 502 rather than inventing data.
GRAPH_TOKEN_API_KEY=                # free + instant, https://thegraph.market
GRAPH_SUBGRAPH_KEY=                 # free + instant, https://thegraph.com/studio
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV   # Uniswap V3 mainnet
GRAPH_QUOTE_ADDRESS=0x28C6c06298d514Db089934071355E5743bf21d60   # whose holdings are sold
GRAPH_QUOTE_NETWORK=mainnet
# GRAPH_API_BASE=https://api.pinax.network/v1
# GRAPH_GATEWAY_BASE=https://gateway.thegraph.com/api

# ─── Block-height provenance ───────────────────────────────────────────────
# A public Ethereum RPC the BUYER picks for itself, to source a chain head and
# sign a floor of `indexedBlock >= head - MAX_BLOCKS_BEHIND`. If unreachable
# the buyer omits the clause and says so, rather than signing a vacuous one.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
MAX_BLOCKS_BEHIND=200

# ─── Tuning ────────────────────────────────────────────────────────────────
PROXY_TIMEOUT_MS=45000              # must stay below the terms deadline
SELLER_PRICE_TINYBARS=50000000      # 0.5 HBAR per request
SELLER_STALE_BY_SECONDS=7200        # how far `subtle` mode rewinds the snapshot

# ─── The "run a real deal" button on the ledger page ───────────────────────
# The ledger at / lets a visitor start a real purchase. Every press spends
# testnet HBAR and starts a child process, so it is capped and spaced out:
# one run at a time, and no faster than MIN_GAP_MS apart. Set MAX_RUNS to 0 to
# turn the button off entirely for a deployment you do not want spending.
RECEIPT_DEMO_MAX_RUNS=200
RECEIPT_DEMO_MIN_GAP_MS=15000

# ─── Base Sepolia escape hatch (BUILD.md §6) ───────────────────────────────
# FALLBACK_RPC_URL=https://sepolia.base.org
# FALLBACK_CHAIN_ID=84532
# VALUE_SCALE=1                     # wei signed == wei in msg.value
